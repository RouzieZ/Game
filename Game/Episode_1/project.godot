; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="После звонка"
config/description="Текстовая нелинейная survival drama / интерактивная книга / зомби-апокалипсис."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameState="*res://scripts/GameState.gd"
SettingsManager="*res://scripts/SettingsManager.gd"
InventoryManager="*res://scripts/InventoryManager.gd"
ChoiceResolver="*res://scripts/ChoiceResolver.gd"
EndingManager="*res://scripts/EndingManager.gd"
SaveManager="*res://scripts/SaveManager.gd"
YandexSDK="*res://scripts/YandexSDK.gd"
StoryManager="*res://scripts/StoryManager.gd"
UIManager="*res://scripts/UIManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[html5]

export/web_export_template="release"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_astc=true
global_illumination/gi_probes/compress=true
environment/default_clear_color=Color(0.13, 0.13, 0.13, 1)
